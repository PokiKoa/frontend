# Ruta base del API. En desarrollo pasa por el proxy de Vite (mismo origen),
# lo que permite que el navegador envíe la cookie httpOnly del refresh token.
VITE_API_URL=/api/v1

# Base de los WebSockets. Vacío = mismo origen que la página (también vía proxy).
VITE_WS_URL=

# Backend al que apunta el proxy de Vite en desarrollo.
VITE_BACKEND_ORIGIN=http://localhost:8000
